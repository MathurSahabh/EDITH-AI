# ── LLM ──────────────────────────────────────────────────────────────────────
# Required: get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional: override the default model (OpenRouter catalog)
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: OpenRouter request metadata
# OPENROUTER_SITE_URL=https://your-app.example.com
# OPENROUTER_APP_NAME=EDITH-AI

# Optional: override OpenRouter base URL
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Web / Search ──────────────────────────────────────────────────────────────
# Optional: enables weather commands  (https://openweathermap.org/api)
OPENWEATHER_API_KEY=

# Optional: enables Bing web search  (https://www.microsoft.com/en-us/bing/apis)
BING_API_KEY=
BING_ENDPOINT=https://api.bing.microsoft.com/v7.0/search

# ── Email ─────────────────────────────────────────────────────────────────────
# Default provider: gmail | outlook
EMAIL_PROVIDER_DEFAULT=gmail

# Gmail – path to your OAuth client secret JSON (downloaded from Google Cloud Console)
GMAIL_CLIENT_SECRET_PATH=secrets/google_client_secret.json
GMAIL_TOKEN_PATH=tokens/gmail_token.json

# Outlook – Azure AD app registration client ID and tenant
OUTLOOK_CLIENT_ID=
AZURE_TENANT_ID=common
OUTLOOK_TOKEN_PATH=tokens/outlook_token.json

# ── App ───────────────────────────────────────────────────────────────────────
# Enable text-to-speech output (true / false)
ENABLE_TTS=true

# SQLite database path for conversation memory
DB_PATH=data/edith.db

# HTTP request timeout in seconds
REQUEST_TIMEOUT_SEC=25

# Maximum web search results returned per query
MAX_WEB_RESULTS=8
